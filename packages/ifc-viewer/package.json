{
  "name": "@nocoast/ifc-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "IFC 3D viewer for the NoCoast-AEC agent loop: inline orbitable turn cards, inspector panel, PNG snapshots.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "fixtures": "node scripts/make-fixtures.mjs",
    "e2e": "node scripts/e2e.mjs",
    "validate": "node scripts/validate-ifc.mjs"
  },
  "peerDependencies": {
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "camera-controls": "^3.1.2",
    "react": ">=18",
    "react-dom": ">=18",
    "three": "0.186.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "camera-controls": "3.1.2",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "web-ifc": "0.0.77"
  }
}
