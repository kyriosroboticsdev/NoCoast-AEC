{"id": "moulded_case_circuit_breaker", "name": "Moulded case circuit breaker (MCCB)", "description": "Moulded case circuit breaker for feeders of about 16 to 1600 A, fixed by its back to a mounting plate inside a switchboard or in its own enclosure. Defaults are a 250 A frame, 3 pole: 105 mm wide (35 mm per pole), 161 mm high, 86 mm deep. A 630 A frame is about 140 x 255 x 110 mm.", "tags": ["mccb", "moulded case breaker", "molded case circuit breaker", "circuit breaker", "feeder breaker", "protection", "power distribution", "electrical"], "ifc_class": "IfcProtectiveDevice", "predefined_type": "CIRCUITBREAKER", "params": {"poles": [3, 1, 4, "-", "number of poles"], "pole_pitch": [0.035, 0.025, 0.07, "m", "width per pole"], "h": [0.161, 0.12, 0.4, "m", "height"], "d": [0.086, 0.06, 0.2, "m", "depth including the toggle"]}, "geometry": [{"shape": "box", "at": [0, 0, 0], "size": ["(poles * pole_pitch)", "0.75 * d", "h"]}, {"shape": "box", "at": ["0.12 * (poles * pole_pitch)", "0.75 * d", "0.3 * h"], "material": "face", "size": ["0.76 * (poles * pole_pitch)", "0.13 * d", "0.4 * h"]}, {"shape": "box", "at": ["(poles * pole_pitch) / 2 - 0.012", "0.88 * d", "0.45 * h"], "material": "dark", "size": [0.024, "0.12 * d", "0.12 * h"]}, {"shape": "box", "at": ["(i + 0.2) * pole_pitch", "0.75 * d", "0.04 * h"], "material": "dark", "repeat": {"count": "poles", "var": "i"}, "size": ["0.6 * pole_pitch", 0.003, "0.12 * h"]}, {"shape": "box", "at": ["(i + 0.2) * pole_pitch", "0.75 * d", "0.84 * h"], "material": "dark", "repeat": {"count": "poles", "var": "i"}, "size": ["0.6 * pole_pitch", 0.003, "0.12 * h"]}], "origin": ["(poles * pole_pitch) / 2", "d / 2", 0], "mount": "fix", "elevation": 1.4, "materials": {"default": {"color": [0.2, 0.2, 0.22], "name": "Thermoset plastic"}, "face": {"color": [0.72, 0.73, 0.74], "name": "Plastic"}, "dark": {"color": [0.1, 0.1, 0.11], "name": "Plastic"}}, "connectors": [{"kind": "power"}], "collides": false, "properties": {"frame_size_a": 250, "rated_