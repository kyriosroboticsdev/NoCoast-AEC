{"id": "dry_riser_inlet_box", "name": "Dry riser inlet box", "description": "Fire brigade breeching inlet in a glazed steel box on the outside wall, feeding a dry rising main. Defaults are a 2-way horizontal box about 600 x 400 x 300 mm with two 65 mm instantaneous inlets on a 100 mm riser; use 4 inlets and a box about 600 x 600 mm for a 150 mm riser. Lower edge of the box 400 to 600 mm above ground (BS 9990); inlet to BS 5041-3, box to BS 5041-5.", "tags": ["dry riser inlet", "breeching inlet", "dry riser", "rising main", "fire brigade inlet", "inlet box", "firefighting", "suppression", "fire"], "ifc_class": "IfcFireSuppressionTerminal", "predefined_type": "BREECHINGINLET", "params": {"w": [0.6, 0.4, 0.85, "m", "box width"], "h": [0.4, 0.4, 0.8, "m", "box height"], "d": [0.3, 0.2, 0.4, "m", "box depth"], "inlets": [2, 2, 4, "-", "number of 65 mm inlets"]}, "geometry": [{"shape": "box", "at": ["-w / 2", 0, 0], "material": "red", "size": ["w", "d", "h"], "subtract": [{"shape": "box", "at": ["-w / 2 + 0.02", 0.02, 0.02], "size": ["w - 0.04", "d", "h - 0.04"]}]}, {"shape": "extrude", "at": [0, "d + 0.02", 0], "rotate": [90, 0, 0], "material": "red", "profile": {"points": [["-(w) / 2", 0], ["(w) / 2", 0], ["(w) / 2", "h"], ["-(w) / 2", "h"]], "holes": [[["-(w) / 2 + 0.04", 0.04], ["(w) / 2 - 0.04", 0.04], ["(w) / 2 - 0.04", "(h) - 0.04"], ["-(w) / 2 + 0.04", "(h) - 0.04"]]]}, "height": 0.02}, {"shape": "box", "at": ["-w / 2 + 0.04", "d + 0.007", 0.04], "material": "glass", "size": ["w - 0.08", 0.006, "h - 0.08"]}, {"shape": "cylinder", "at": ["-w * 0.25", "d * 0.4", "h * 0.5"], "rotate": [0, 90, 0], "material": "iron", "radius": 0.05, "height": "w * 0.5"}, {"shape": "cylinder", "at": [0, "d * 0.4", 0], "material": "iron", "radius": 0.05, "height": "h * 0.5"}, {"shape": "cylinder", "at": ["(i % 2 - 0.5) * w * 0.4", "d * 0.4", "h * (floor(i / 2) + 0.5) / ceil(round(inlets) / 2)"], "rotate": [-90, 0, 0], "material": "brass", "radius": 0.0325, "height": "d * 0.45", "repeat"