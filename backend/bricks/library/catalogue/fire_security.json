{"id": "concealed_sprinkler", "name": "Concealed sprinkler", "description": "Pendent sprinkler recessed into a suspended ceiling behind a flat cover plate that drops away at a temperature a little below the sprinkler's own rating. Only the cover plate and its retainer are modelled; the body sits in the ceiling void. Defaults: 83 mm (3 1/4 in) white cover plate, K80, 68 C sprinkler with a 57 C plate. Typical values.", "tags": ["concealed sprinkler", "flush sprinkler", "cover plate sprinkler", "sprinkler", "fire sprinkler", "suppression", "fire"], "ifc_class": "IfcFireSuppressionTerminal", "predefined_type": "SPRINKLER", "params": {"cover": [0.083, 0.06, 0.1, "m", "cover plate diameter"]}, "geometry": [{"shape": "cylinder", "at": [0, 0, 0], "material": "whitesteel", "radius": "cover / 2", "height": 0.003}, {"shape": "cylinder", "at": [0, 0, 0.003], "material": "brass", "radius": "cover / 2 - 0.006", "height": 0.005, "inner": "cover / 2 - 0.012"}, {"shape": "cylinder", "at": [0, 0, 0.006], "material": "brass", "radius": "cover / 2 - 0.012", "height": 0.002}], "origin": [0, 0, 0], "mount": "hang", "materials": {"whitesteel": {"color": [0.92, 0.92, 0.9], "name": "Painted steel, white"}, "brass": {"color": [0.78, 0.62, 0.25], "name": "Brass"}}, "connectors": [{"kind": "fire_water"}], "collides": false, "properties": {"k_factor_metric": 80, "temperature_rating_c": 68, "cover_plate_rating_c": 57, "orientation": "concealed pendent"}},
{"id": "sprinkler_water_shield", "name": "Sprinkler water shield", "description": "Dished metal disc fixed on the drop just above an intermediate level or in-rack sprinkler, so that water from sprinklers higher up does not cool its bulb. Default 100 mm diameter; shields are commonly 75 to 150 mm. The sprinkler itself is a separate brick placed directly below.", "tags": ["water shield", "sprinkler shield", "sprinkler deflector", "sprinkler baffle", "in rack sprinkler", "suppression", "fire"], "ifc_class": "IfcFireSuppressionTerminal", "predefined_type": "SPRINKLERDEFLECTOR", "params": {"dia": [0.1, 0.075, 0.15, "m", "shield diameter"], "drop": [0.3, 0.05, 3.0, "m", "top of the shield below the soffit"]}, "geometry": [{"shape": "revolve", "at": [0, 0, 0], "material": "galv", "profile": [[0.0105, 0.0085], ["dia / 2", 0], ["dia / 2", 0.0015], [0.0105, 0.01]]}, {"shape": "cylinder", "at": [0, 0, 0.006], "material": "galv", "radius": 0.016, "height": 0.014, "inner": 0.0105}], "origin": [0, 0, 0], "mount": "hang", "elevation": "drop", "materials": {"galv": {"color": [0.7, 0.73, 0.76], "name": "Galvanised steel"}}, "collides": false, "properties": {"shield_diameter_mm": 100, "fits_thread_mm": 15}},
