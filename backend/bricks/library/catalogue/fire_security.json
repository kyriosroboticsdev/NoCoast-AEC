{"id": "pillar_fire_hydrant", "name": "Pillar fire hydrant", "description": "Above-ground pillar hydrant on a flanged inlet from the fire main, with side outlets and a top operating nut. Defaults: DN100 inlet, two 65 mm outlets, about 0.85 m above ground (pillar hydrants to BS EN 14384 are DN80, DN100 or DN150, PN16). Give 3 outlets for a front pumper connection. Keep about 1 m clear all round.", "tags": ["pillar hydrant", "above ground hydrant", "hydrant", "fire main", "firefighting", "suppression", "fire", "outdoor"], "ifc_class": "IfcFireSuppressionTerminal", "predefined_type": "FIREHYDRANT", "params": {"h": [0.85, 0.7, 1.1, "m", "height above ground"], "dia": [0.2, 0.15, 0.3, "m", "barrel diameter"], "outlets": [2, 1, 3, "-", "number of outlets"]}, "geometry": [{"shape": "cylinder", "at": [0, 0, 0], "material": "red", "radius": "dia / 2 + 0.06", "height": 0.03}, {"shape": "cylinder", "at": [0, 0, 0.03], "material": "red", "radius": "dia / 2", "height": "h * 0.8 - 0.03"}, {"shape": "revolve", "at": [0, 0, "h * 0.8"], "material": "red", "profile": [[0, 0], ["dia / 2 + 0.02", 0], ["dia / 2 + 0.02", 0.03], ["dia * 0.4", "h * 0.12"], ["dia * 0.2", "h * 0.17"], [0, "h * 0.17"]]}, {"shape": "extrude", "at": [0, 0, "h * 0.97"], "material": "iron", "profile": {"ngon": 5, "radius": 0.025}, "height": "h * 0.03"}, {"shape": "cylinder", "at": [0, 0, "h * 0.6"], "rotate": [0, 90, "180 * i if i < 2 else 90"], "material": "red", "radius": 0.045, "height": "dia / 2 + 0.09", "repeat": {"count": "outlets", "var": "i"}}, {"shape": "cylinder", "at": ["(dia / 2 + 0.09) * cos(180 * i if i < 2 else 90)", "(dia / 2 + 0.09) * sin(180 * i if i < 2 else 90)", "h * 0.6"], "rotate": [0, 90, "180 * i if i < 2 else 90"], "material": "iron", "radius": 0.058, "height": 0.04, "repeat": {"count": "outlets", "var": "i"}}], "origin": [0, 0, 0], "mount": "rest", "materials": {"red": {"color": [0.8, 0.12, 0.12], "name": "Painted steel, red"}, "iron": {"color": [0.25, 0.25, 0.27], "name": "Ductile iron