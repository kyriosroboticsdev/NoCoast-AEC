# Copy to backend/.env. All values optional; defaults shown.

# mock | ollama | openai
LLM_PROVIDER=mock

# Ollama:   LLM_MODEL=llama3.1   LLM_BASE_URL=http://127.0.0.1:11434
# OpenAI-compatible (vLLM, LM Studio, llama.cpp server, hosted, a fine-tuned model):
#           LLM_MODEL=<model id> LLM_BASE_URL=http://host:port/v1  LLM_API_KEY=<key if required>
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=600

# Validate/repair round-trips allowed per LLM call
BIM_MAX_REPAIRS=2

BIM_PORT=8765
# BIM_OUTPUT_DIR=./output
# BIM_DB_PATH=./output/projects.sqlite3
