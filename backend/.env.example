# Copy to backend/.env. All values optional; defaults shown.

# mock | llamacpp | claude | ollama | openai
LLM_PROVIDER=mock

# Local GGUF via llama.cpp (run `python tools/get_llama.py` once to fetch llama-server):
#           LLM_PROVIDER=llamacpp  LLM_MODEL=qwen3-4b-instruct-2507-q4_k_m.gguf  LLM_MODELS_DIR=D:\Models
#           optional: LLAMA_SERVER=<path to llama-server.exe>  LLAMA_GPU_LAYERS=99  LLAMA_CTX=16384
# Claude:   LLM_PROVIDER=claude  LLM_MODEL=claude-opus-5 (default)  plus ANTHROPIC_API_KEY below
#           (org-level keys also need ANTHROPIC_WORKSPACE_ID=wrkspc_...)
# Ollama:   LLM_PROVIDER=ollama  LLM_MODEL=llama3.1  LLM_BASE_URL=http://127.0.0.1:11434
# OpenAI-compatible (vLLM, LM Studio, a hosted API, a fine-tuned model):
#           LLM_PROVIDER=openai  LLM_MODEL=<model id>  LLM_BASE_URL=http://host:port/v1  LLM_API_KEY=<key if required>
LLM_MODEL=
LLM_MODELS_DIR=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=600
# ANTHROPIC_API_KEY=sk-ant-...        (claude provider; read by the Anthropic SDK)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   (only for keys created at organisation level)

# Validate/repair round-trips allowed per LLM call
BIM_MAX_REPAIRS=2

# Extra attempts when a call fails because the network dropped or the provider is briefly overloaded
# (timeouts, connection resets, 429, 502, 503, 529). A refusal or a bad request is not retried.
# BIM_NET_RETRIES=3

# Visual self-check: the model looks at screenshots of what it built and fixes what it sees.
# Reviews per prompt (0 = off) and camera turns per review. LLM_VISION=1/0 says whether the model can
# see images, the screenshots and the user's attachments (default: on for claude and Anthropic's
# endpoint, and for openai/ollama models whose id names a multimodal family such as *-vl, llama4, gemma3).
# BIM_LOOK_ROUNDS=1
# BIM_LOOK_TURNS=3
# LLM_VISION=1

# Pre-issue code screen: rounds in which failing IBC/IRC clauses (with suggested fix steps) go back to the
# model before the drawings are issued (0 = report only).
# BIM_CODE_ROUNDS=1

# Claude reasoning: effort (low | medium | high) and whether its thinking is streamed into the trace
# (summarized | omitted). Summarized thinking also keeps a long silent think from dropping the stream.
# LLM_EFFORT=medium
# LLM_THINKING=summarized

# Longest reply a provider may generate. A two-storey building with a rationale per move runs well
# past 16k tokens; lower this if your model's ceiling is lower.
LLM_MAX_TOKENS=32000

# How chatty the live stream is, in seconds (see README §4.5). Raise them on a slow machine.
# BIM_STREAM_EVERY=0.12       throughput events
# BIM_DRAFT_EVERY=0.15        "drafting a window in the kitchen…" events
# BIM_PREVIEW_DEBOUNCE=0.15   how long a later preview waits for more steps; the first one does not wait
# BIM_HEARTBEAT_EVERY=1.0     "still writing…" while the model is silent
# BIM_THINK_EVERY=0.25        the paragraph of the model's thinking still being written

# Mock provider only: how finely it slices its reply, and seconds between slices (demos/screenshots)
# BIM_MOCK_SLICES=32
# BIM_MOCK_DELAY=0

# Console verbosity: INFO (default) or DEBUG (logs full LLM prompts and replies)
BIM_LOG_LEVEL=INFO

BIM_PORT=8765
# BIM_OUTPUT_DIR=./output
# BIM_DB_PATH=./output/projects.sqlite3
