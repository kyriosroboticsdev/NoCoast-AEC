{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@nocoast/ifc-viewer": [
        "../packages/ifc-viewer/src/index.ts"
      ],
      "three": [
        "./node_modules/@types/three"
      ],
      "three/*": [
        "./node_modules/@types/three/*"
      ],
      "@thatopen/components": [
        "./node_modules/@thatopen/components"
      ],
      "@thatopen/fragments": [
        "./node_modules/@thatopen/fragments"
      ],
      "web-ifc": [
        "./node_modules/web-ifc"
      ],
      "camera-controls": [
        "./node_modules/camera-controls"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
