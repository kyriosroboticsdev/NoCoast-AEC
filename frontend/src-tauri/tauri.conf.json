{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoCoast AEC",
  "version": "0.2.0",
  "identifier": "dev.kyriosrobotics.nocoast",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "NoCoast AEC", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
