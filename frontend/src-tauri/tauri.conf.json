{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Generative BIM",
  "version": "0.1.0",
  "identifier": "dev.nocoast.generativebim",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tekt",
        "width": 1500,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0f1115",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
