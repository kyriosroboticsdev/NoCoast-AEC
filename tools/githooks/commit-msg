#!/bin/sh
# Stamp every commit with the workstream it came from, so history stays readable after merges:
#   Workstream: feat/generative-bim-pipeline
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
grep -q '^Workstream:' "$1" && exit 0
git interpret-trailers --in-place --if-exists doNothing --trailer "Workstream: $branch" "$1"
